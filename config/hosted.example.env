# Hosted control-plane settings.
#
# Provision per-user bearer keys with: python main.py hosted-key --user USER_ID
# Only hashes are stored. No shared HOSTED_API_TOKEN is accepted.

HOSTED_API_HOST=0.0.0.0
HOSTED_API_PORT=8080

# Reference worker mode. Leave unset/0 for smoke tests. A real public SaaS should
# execute each run in a per-user isolated container/workspace before enabling
# browser automation.
HOSTED_WORKER_EXECUTE=0
HOSTED_WORKER_POLL_SECONDS=2

POSTGRES_DB=job_agent
POSTGRES_USER=job_agent
POSTGRES_PASSWORD=job_agent_dev_password
DATABASE_URL=postgresql://job_agent:job_agent_dev_password@postgres:5432/job_agent
