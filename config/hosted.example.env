# Hosted control-plane settings.
#
# Provision per-user bearer keys with: python main.py hosted-key --user USER_ID
# Only hashes are stored. No shared HOSTED_API_TOKEN is accepted.

HOSTED_API_HOST=0.0.0.0
HOSTED_API_PORT=8080
# Comma-separated browser origins allowed to call the hosted API. Non-browser
# clients without an Origin header still work.
HOSTED_API_ALLOWED_ORIGINS=https://app.example.com
HOSTED_API_RATE_LIMIT_PER_MINUTE=120

# Reference worker mode. Leave unset/0 for smoke tests. A real public SaaS should
# execute each run in a per-user isolated container/workspace before enabling
# browser automation.
HOSTED_WORKER_EXECUTE=0
HOSTED_WORKER_POLL_SECONDS=2
HOSTED_WORKER_WORKSPACE_DIR=/app/data/hosted_workspaces
HOSTED_WORKER_HEARTBEAT_SECONDS=15
HOSTED_WORKER_RUN_TIMEOUT_SECONDS=3600
# Keep this unset/0 unless the worker runs inside a per-user isolated browser
# container and the user has explicitly authorized live submissions.
HOSTED_WORKER_ALLOW_LIVE_APPLY=0
# workspace is suitable for local smoke tests. staging/production live apply
# requires container so a misconfigured public worker fails closed.
HOSTED_WORKER_ISOLATION_MODE=workspace

# Production artifact storage. Keep local for smoke tests; use s3 in
# staging/production so generated resumes and letters survive worker restarts.
ARTIFACT_STORAGE_BACKEND=local
ARTIFACT_STORAGE_DIR=/app/data/artifacts
# ARTIFACT_STORAGE_BACKEND=s3
# ARTIFACT_S3_BUCKET=job-agent-artifacts
# ARTIFACT_S3_PREFIX=job-agent
# ARTIFACT_S3_ENDPOINT_URL=https://s3.example.com

POSTGRES_DB=job_agent
POSTGRES_USER=job_agent
POSTGRES_PASSWORD=job_agent_dev_password
DATABASE_URL=postgresql://job_agent:job_agent_dev_password@postgres:5432/job_agent
