# ==============================================================================
# Autonomous AI Job Search & Application Agent - Environment Configuration
#
# Copy to .env and fill in what you have. Every LLM-backed stage has a
# deterministic fallback, so the pipeline runs end to end with no keys at all.
# Placeholder values ending in "_here" are treated as "not configured".
# ==============================================================================

# --- PRIVACY & TELEMETRY SAFEGUARDS ---
# Disables telemetry across the dependency tree to protect applicant data.
ANONYMIZED_TELEMETRY=false

# --- LLM CONFIGURATION ---
# Provider: "openai" | "anthropic" | "none"
DEFAULT_LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI model per stage
LLM_INTAKE_MODEL=gpt-4o
LLM_RERANK_MODEL=gpt-4o
LLM_TAILOR_MODEL=gpt-4o

# Model used for every stage when DEFAULT_LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-5

# --- PHASE 1: DOCUMENT PARSING ---
# Optional; falls back to pdfplumber/pypdf plus structured extraction.
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key_here

# --- PHASE 2: PROXY & NETWORK ---
# Format: http://user:pass@gate.proxyhost.com:port
RESIDENTIAL_PROXY_URL=

# --- PHASE 3: SEMANTIC EVALUATION ---
SEMANTIC_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Tier 1 cosine similarity cutoff (0.0-1.0). Lower it if nothing clears the gate.
TIER1_THRESHOLD=0.15
# Tier 2 fit score a job must reach to qualify (1.0-10.0).
MIN_MATCH_SCORE=7.0

# --- PHASE 5: BROWSER AUTOMATION SAFEGUARDS ---
# DOM-only perception; no vision model, which is faster and cheaper.
USE_VISION=false
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_WAIT_STRATEGY=networkidle
MAX_APPLICATION_STEPS=25

# Ask for confirmation before the first real (non-dry-run) submission.
# Set to false only for unattended scheduled runs you have explicitly opted into.
REQUIRE_APPLY_CONFIRMATION=true

# Optional CAPTCHA solving API; when empty, a CAPTCHA triggers a human-in-the-loop pause.
CAPSOLVER_API_KEY=
