# ==============================================================================
# Autonomous AI Job Search & Application Agent - Environment Configuration
#
# Copy to .env and fill in what you have. Every LLM-backed stage has a
# deterministic fallback, so the pipeline runs end to end with no keys at all.
# Placeholder values ending in "_here" are treated as "not configured".
# ==============================================================================

# --- PRIVACY & TELEMETRY SAFEGUARDS ---
# Disables telemetry across the dependency tree to protect applicant data.
ANONYMIZED_TELEMETRY=false

# --- LLM CONFIGURATION ---
# Provider: "openai" | "anthropic" | "groq" | "none"
DEFAULT_LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Groq uses requests directly; no OpenAI account or SDK is required.
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-120b
# Used when GROQ_MODEL's free-tier daily token limit (200,000/day) is used up.
# It has its own daily allowance, so a long run continues instead of stopping.
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT=45
# Any provider with an OpenAI-compatible /v1 chat completions endpoint.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini
# Stop on model failure instead of silently using deterministic results.
LLM_STRICT=false

# OpenAI model per stage
LLM_INTAKE_MODEL=gpt-4o
LLM_RERANK_MODEL=gpt-4o
LLM_TAILOR_MODEL=gpt-4o

# Model used for every stage when DEFAULT_LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-5

# --- PHASE 1: DOCUMENT PARSING ---
# Optional; falls back to pdfplumber/pypdf plus structured extraction.
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key_here

# --- CONTACT DISCOVERY (optional) ---
# Hunter.io key for finding a company's published role mailboxes (careers@, hr@)
# when neither the job post nor the company website lists one. Free tier: 25/month.
HUNTER_API_KEY=

# --- HOSTED DATABASE (Docker / hosted API) ---
POSTGRES_DB=job_agent
POSTGRES_USER=job_agent
POSTGRES_PASSWORD=job_agent_dev_password
DATABASE_URL=postgresql://job_agent:job_agent_dev_password@postgres:5432/job_agent

# --- PHASE 2: PROXY & NETWORK ---
# Format: http://user:pass@gate.proxyhost.com:port
RESIDENTIAL_PROXY_URL=

# --- PHASE 3: SEMANTIC EVALUATION ---
SEMANTIC_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Tier 1 cosine similarity cutoff (0.0-1.0). Lower it if nothing clears the gate.
TIER1_THRESHOLD=0.15
# Tier 2 fit score a job must reach to qualify (1.0-10.0).
MIN_MATCH_SCORE=7.0

# --- PHASE 5: BROWSER AUTOMATION SAFEGUARDS ---
# DOM-only perception; no vision model, which is faster and cheaper.
USE_VISION=false
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_WAIT_STRATEGY=networkidle
MAX_APPLICATION_STEPS=25

# Ask for confirmation before the first real (non-dry-run) submission.
# Set to false only for unattended scheduled runs you have explicitly opted into.
REQUIRE_APPLY_CONFIRMATION=true

# Optional CAPTCHA solving API; when empty, a CAPTCHA triggers a human-in-the-loop pause.
CAPSOLVER_API_KEY=

# --- OPTIONAL READ-ONLY REPLY TRACKING ---
# All four values are required. Choose a dedicated folder containing applications.
# No email is ever sent. Use an app password, not your main account password.
IMAP_HOST=
IMAP_USER=
IMAP_APP_PASSWORD=
IMAP_FOLDER=
# Explicitly opt in before ambiguous matched email text is sent to your LLM.
INBOX_USE_LLM=0

# --- OPTIONAL DASHBOARD REMOTE-ACCESS HARDENING ---
# The dashboard (python main.py ui) still binds to loopback only; these are for
# reaching that loopback port through a private tunnel you control, such as
# `tailscale serve https / http://127.0.0.1:8765`, not for exposing it directly
# on the open internet. Set both to require a login. Leave both empty for the
# unchanged, purely local, no-login behavior.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
# Comma-separated extra hostnames to accept, e.g. the one your tunnel presents
# to the browser (yourdevice.tailnnnn.ts.net). Only needed with a tunnel; set
# DASHBOARD_USERNAME/DASHBOARD_PASSWORD too whenever this is non-empty.
DASHBOARD_ALLOWED_HOSTS=
